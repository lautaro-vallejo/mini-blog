# Configuración local de ejemplo. No contiene credenciales reales.
# Formato: motor://usuario:clave@host:puerto/basededatos
DATABASE_URL=sqlite:///./blog.db
DB_ECHO=false

# JWT: generá un secreto propio, por ejemplo con:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET=cambiar-por-un-secreto-largo
JWT_ALG=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30

# Subida de imágenes
MAX_UPLOAD_MB=3
